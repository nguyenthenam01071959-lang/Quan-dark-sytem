local function makeButton(name,callback)
    local b = Instance.new("TextButton")
    b.Name = name
    b.BackgroundColor3 = Color3.fromRGB(37,37,42)
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 13
