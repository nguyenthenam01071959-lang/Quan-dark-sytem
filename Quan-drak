-- FLY
local flyButton

local function stopFly()
    flyEnabled = false

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end
    if flyAlign then
        flyAlign:Destroy()
        flyAlign = nil
    end
    if flyAttachment then
        flyAttachment:Destroy()
        flyAttachment = nil
    end

    if humanoid then
        humanoid.AutoRotate = true
    end

    if flyButton then
        updateButton(flyButton, "Fly", false)
    end
end

local function startFly()
    if not root or not humanoid then return end

    stopFly()
    flyEnabled = true
    humanoid.AutoRotate = false

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.MaxForce = 1000000
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = root

    flyAlign = Instance.new("AlignOrientation")
    flyAlign.Attachment0 = flyAttachment
    flyAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyAlign.MaxTorque = 1000000
    flyAlign.Responsiveness = 15
    flyAlign.Parent = root

    if flyButton then
        updateButton(flyButton, "Fly", true)
    end
end

connections.fly = RunService.RenderStepped:Connect(function()
    if not flyEnabled then return end
    if not root or not root.Parent or not humanoid then
        stopFly()
        return
    end

    local cam = workspace.CurrentCamera
    if not cam or not flyVelocity then return end

    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local move = humanoid.MoveDirection

    local flatForward = Vector3.new(look.X, 0, look.Z)
    local flatRight = Vector3.new(right.X, 0, right.Z)

    if flatForward.Magnitude < 0.01 then
        flatForward = Vector3.new(0,0,-1)
    else
        flatForward = flatForward.Unit
    end

    flatRight = flatRight.Magnitude > 0.01
        and flatRight.Unit or Vector3.new(1,0,0)

    local forwardInput = move:Dot(flatForward)
    local sideInput = move:Dot(flatRight)

    local direction = look * forwardInput + right * sideInput
    if direction.Magnitude > 1 then
        direction = direction.Unit
    end

    flyVelocity.VectorVelocity =
        direction * FLY_SPEED + Vector3.new(0, verticalInput * FLY_SPEED, 0)

    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 0.01 and flyAlign then
        flyAlign.CFrame = CFrame.lookAt(
            Vector3.zero, flatLook.Unit, Vector3.yAxis
        )
    end
end)

-- FLOAT WITH PLATFORM
local floatButton

local function stopFloat()
    floatEnabled = false
    if floatConnection then
        floatConnection:Disconnect()
        floatConnection = nil
    end
    if floatBlock then
        floatBlock:Destroy()
        floatBlock = nil
    end
    if floatButton then
        updateButton(floatButton, "Float", false)
    end
end

local function startFloat()
    if not root then return end

    stopFloat()
    floatEnabled = true

    floatBlock = Instance.new("Part")
    floatBlock.Name = "QUAN_FLOAT_PLATFORM"
    floatBlock.Size = Vector3.new(6, 0.5, 6)
    floatBlock.Anchored = true
    floatBlock.CanCollide = true
    floatBlock.Transparency = 0.35
    floatBlock.Material = Enum.Material.ForceField
    floatBlock.Color = Color3.fromRGB(50,130,255)
    floatBlock.Parent = workspace

    floatConnection = RunService.Heartbeat:Connect(function()
        if not floatEnabled or not root or not root.Parent then
            stopFloat()
            return
        end

        floatBlock.CanCollide = not flyEnabled
        floatBlock.Position = root.Position - Vector3.new(0,3.5,0)
    end)

    if floatButton then
        updateButton(floatButton, "Float", true)
    end
end

-- NOCLIP
local noclipButton

local function setNoclip(enabled)
    noclipEnabled = enabled

    if not enabled then
        for part, oldValue in pairs(oldCollisions) do
            if part and part.Parent then
                part.CanCollide = oldValue
            end
        end
        table.clear(oldCollisions)
    end

    if noclipButton then
        updateButton(noclipButton, "Noclip", enabled)
    end
end

connections.noclip = RunService.Stepped:Connect(function()
    if not noclipEnabled or not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if oldCollisions[part] == nil then
                oldCollisions[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end)

-- ESP
local function clearESP()
    for target, guiObject in pairs(espObjects) do
        if guiObject then guiObject:Destroy() end
    end
    table.clear(espObjects)
end

local function createESP(target)
    if target == player or not target.Character then return end

    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "QUAN_ESP"
    billboard.Size = UDim2.fromOffset(150,35)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = targetRoot
    billboard.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1,1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(100,220,255)
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Parent = billboard

    espObjects[target] = billboard

    task.spawn(function()
        while espEnabled and billboard.Parent do
            if root and target.Character then
                local otherRoot =
                    target.Character:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local distance = math.floor(
                        (root.Position - otherRoot.Position).Magnitude
                    )
                    label.Text = target.Name .. " [" .. distance .. "m]"
                end
            end
            task.wait(0.6)
        end
    end)
end

local function setESP(enabled)
    espEnabled = enabled
    clearESP()

    if enabled then
        for _, target in ipairs(Players:GetPlayers()) do
            createESP(target)
        end
    end
end

-- TAB CONTENT
function showTab(name)
    if name == "FLIGHT" then
        flyButton = makeButton("Fly: " .. (flyEnabled and "ON" or "OFF"), function()
            if flyEnabled then stopFly() else startFly() end
        end)

        floatButton = makeButton("Float: " .. (floatEnabled and "ON" or "OFF"), function()
            if floatEnabled then stopFloat() else startFloat() end
        end)

        makeButton("Fly Speed +", function()
            FLY_SPEED = math.clamp(FLY_SPEED + 10, 10, 500)
        end)

        makeButton("Fly Speed -", function()
            FLY_SPEED = math.clamp(FLY_SPEED - 10, 10, 500)
        end)

        local up = makeButton("HOLD: FLY UP", function()
            verticalInput = 1
        end)
        up.MouseButton1Down:Connect(function()
            verticalInput = 1
        end)
        up.MouseButton1Up:Connect(function()
            verticalInput = 0
        end)

        local down = makeButton("HOLD: FLY DOWN", function()
            verticalInput = -1
        end)
        down.MouseButton1Down:Connect(function()
            verticalInput = -1
        end)
        down.MouseButton1Up:Connect(function()
            verticalInput = 0
        end)

    elseif name == "MOVE" then
        makeButton("Walk Speed +", function()
            WALK_SPEED = math.clamp(WALK_SPEED + 4, 0, 200)
            if humanoid then humanoid.WalkSpeed = WALK_SPEED end
        end)

        makeButton("Walk Speed -", function()
            WALK_SPEED = math.clamp(WALK_SPEED - 4, 0, 200)
            if humanoid then humanoid.WalkSpeed = WALK_SPEED end
        end)

        makeButton("Jump Power +", function()
            JUMP_POWER = math.clamp(JUMP_POWER + 5, 0, 200)
            if humanoid then humanoid.JumpPower = JUMP_POWER end
        end)

        makeButton("Jump Power -", function()
            JUMP_POWER = math.clamp(JUMP_POWER - 5, 0, 200)
            if humanoid then humanoid.JumpPower = JUMP_POWER end
        end)

        local b = makeButton("Infinite Jump: " .. (infiniteJump and "ON" or "OFF"), function()
            infiniteJump = not infiniteJump
            updateButton(b, "Infinite Jump", infiniteJump)
        end)

        local s = makeButton("Sprint: " .. (sprintEnabled and "ON" or "OFF"), function()
            sprintEnabled = not sprintEnabled
            if humanoid then
                humanoid.WalkSpeed = sprintEnabled and WALK_SPEED * 1.5 or WALK_SPEED
            end
            updateButton(s, "Sprint", sprintEnabled)
        end)

        local n = makeButton("Noclip: " .. (noclipEnabled and "ON" or "OFF"), function()
            setNoclip(not noclipEnabled)
        end)
        noclipButton = n

    elseif name == "PLAYER" then
        local f = makeButton("Freeze: " .. (freezeEnabled and "ON" or "OFF"), function()
            freezeEnabled = not freezeEnabled
            if root then root.Anchored = freezeEnabled end
            updateButton(f, "Freeze", freezeEnabled)
        end)

        local e = makeButton("ESP: " .. (espEnabled and "ON" or "OFF"), function()
            setESP(not espEnabled)
            updateButton(e, "ESP", espEnabled)
        end)

        makeButton("Respawn", function()
            if humanoid then humanoid.Health = 0 end
        end)

        makeButton("Sit / Stand", function()
            if humanoid then humanoid.Sit = not humanoid.Sit end
        end)

    elseif name == "CAMERA" then
        makeButton("FOV +", function()
            DEFAULT_FOV = math.clamp(DEFAULT_FOV + 5, 40, 120)
            workspace.CurrentCamera.FieldOfView = DEFAULT_FOV
        end)

        makeButton("FOV -", function()
            DEFAULT_FOV = math.clamp(DEFAULT_FOV - 5, 40, 120)
            workspace.CurrentCamera.FieldOfView = DEFAULT_FOV
        end)

        local s = makeButton("Shift Lock: " .. (shiftEnabled and "ON" or "OFF"), function()
            shiftEnabled = not shiftEnabled
            if humanoid then
                humanoid.CameraOffset = shiftEnabled
                    and Vector3.new(1.7,0,0) or Vector3.zero
            end
            updateButton(s, "Shift Lock", shiftEnabled)
        end)

        makeButton("Reset Camera", function()
            if humanoid then humanoid.CameraOffset = Vector3.zero end
            shiftEnabled = false
            workspace.CurrentCamera.FieldOfView = 70
            DEFAULT_FOV = 70
        end)
    end
end

