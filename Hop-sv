-- KEYBOARD
connections.keys = UIS.InputBegan:Connect(function(input,processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.Q then
        main.Visible = not main.Visible
    elseif input.KeyCode == Enum.KeyCode.Space and flyEnabled then
        verticalInput = 1
    elseif input.KeyCode == Enum.KeyCode.LeftControl and flyEnabled then
        verticalInput = -1
    end
end)

connections.keysEnded = UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space
        or input.KeyCode == Enum.KeyCode.LeftControl then
        verticalInput = 0
    end
end)

connections.jumpRequest = UIS.JumpRequest:Connect(function()
    if infiniteJump and not flyEnabled and humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- PLAYER JOIN
connections.playerAdded = Players.PlayerAdded:Connect(function(target)
    target.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then createESP(target) end
    end)
end)

-- RESPAWN
connections.respawn = player.CharacterAdded:Connect(function(char)
    stopFly()
    stopFloat()
    setNoclip(false)
    clearESP()

    if playerMarker then
        playerMarker:Destroy()
        playerMarker = nil
    end

    selectedTarget = nil
    freezeEnabled = false
    verticalInput = 0
    floatMoveInput = 0

    task.wait(0.3)
    getCharacter(char)

    if shiftEnabled then
        humanoid.CameraOffset = Vector3.new(1.7,0,0)
    end
end)

-- CLEANUP
gui.Destroying:Connect(function()
    stopFly()
    stopFloat()
    setNoclip(false)
    clearESP()

    if playerMarker then
        playerMarker:Destroy()
        playerMarker = nil
    end

    for _,connection in pairs(connections) do
        connection:Disconnect()
    end
end)

