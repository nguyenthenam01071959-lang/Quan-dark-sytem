local function updateButton(b,name,on)
    if not b then return end
    b.Text = name..(on and ": ON" or ": OFF")
    b.BackgroundColor3 = on
        and Color3.fromRGB(30,85,65)
        or Color3.fromRGB(37,37,42)
end

local function makeInput(name,value,callback)
    local box = Instance.new("TextBox")
    box.Name = name
    box.BackgroundColor3 = Color3.fromRGB(28,28,33)
    box.TextColor3 = Color3.new(1,1,1)
    box.PlaceholderColor3 = Color3.fromRGB(170,170,170)
    box.PlaceholderText = name
    box.Text = tostring(value)
    box.TextSize = 12
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = scroll
    round(box,8)

    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)
        if number and number == number then
            callback(number)
        else
            box.Text = tostring(value)
        end
    end)
    return box
end

